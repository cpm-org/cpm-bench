// The package manifest: JSON with comments and trailing commas (JSONC).
// Reference: docs/spec/manifest.md in the CPM repository.
{
  "name": "cpm-bench",
  "version": "0.1.0",
  "description": "Micro-benchmarks for C++20: calibrated batches, the median time per run with its spread, throughput, a check mode for cpm test, and console and JSON reports",
  "license": "MIT",
  "repository": "https://github.com/cpm-org/cpm-bench",
  "keywords": ["benchmark", "performance", "timing"],

  // The oldest standard a project using cpm-bench may have.
  "std": "c++20",

  "type": "static-lib",

  "dependencies": {
    // The runner's command line, and the JSON report.
    "cpm-args": "^0.1.0",
    "cpm-json": "^0.1.0"
  },

  "devDependencies": {
    "cpm-test": "^0.1.0"
  },

  "profiles": {
    // What CI builds with, so the headers stay clean for projects that use every warning CPM knows.
    "strict": { "inherits": "debug", "warnings": "strict", "werror": true },
    // AddressSanitizer and UBSan, on the platforms that have them (CI runs it on Linux).
    "sanitize": { "inherits": "debug", "sanitizers": ["address", "undefined"] }
  }
}
